# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aurik_monitoring

# API Keys (Separate scopes: Ingest, Read, Admin)
API_KEY_INGEST=aurik-ingest-secret-key-prod-001
API_KEY_READ=aurik-read-secret-key-prod-002
API_KEY_ADMIN=aurik-admin-secret-key-prod-003

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_PAYLOAD_BYTES=5242880

# Domain Engine Thresholds & Rule Defaults
ALERT_TTL_MINUTES=120
FRESHNESS_MINUTES=30
VENDOR_CONFLICT_WINDOW_MINUTES=5
TEMP_NEAR_LIMIT_RATIO=0.90
VIB_NEAR_LIMIT_RATIO=0.85
SENSOR_QUALITY_MIN=0.50
POWER_DEVIATION_PCT=20.0
DEFAULT_ASSUMED_TIMEZONE=UTC

# Background Worker Settings
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3
WORKER_POLL_INTERVAL_SECONDS=1.0
