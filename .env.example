# =============================================================================
# Aurik Industrial Monitoring Platform - Environment Configuration Template
# =============================================================================

# Application Environment Mode (development, testing, production)
# In production mode:
# - Interactive OpenAPI/Swagger docs (/docs, /redoc, /openapi.json) are disabled by default
# - API keys MUST be >= 24 chars and cannot equal known example/default keys
APP_ENV=development
ENVIRONMENT=development
LOG_LEVEL=INFO

# Documentation Endpoint Toggle (optional; defaults to True in dev/test, False in prod)
ENABLE_DOCS=true

# HTTP Request Limit (5 MB default)
MAX_PAYLOAD_BYTES=5242880

# CORS Configuration (disabled by default for backend-to-backend security)
# Comma-separated list of allowed origins, e.g. "https://app.aurik.io,https://admin.aurik.io"
CORS_ALLOW_ORIGINS=

# Database Configuration (PostgreSQL 16+ with psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/aurik_monitoring
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=aurik_monitoring
POSTGRES_PORT=5432
API_PORT=8000

# Database Connection Pool & Timeouts
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000

# API Keys (Strict role separation: Ingest, Read, Admin)
# Production keys MUST be random, >= 24 characters, and distinct.
API_KEY_INGEST=aurik-ingest-secret-key-prod-001
API_KEY_READ=aurik-read-secret-key-prod-002
API_KEY_ADMIN=aurik-admin-secret-key-prod-003

# Domain Engine Thresholds & Rule Configuration
ALERT_TTL_MINUTES=120
FRESHNESS_MINUTES=30
VENDOR_CONFLICT_WINDOW_MINUTES=5
TEMP_NEAR_LIMIT_RATIO=0.90
VIB_NEAR_LIMIT_RATIO=0.85
SENSOR_QUALITY_MIN=0.50
POWER_DEVIATION_PCT=20.0
DEFAULT_ASSUMED_TIMEZONE=UTC

# Background Queue Worker Configuration
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3
WORKER_POLL_INTERVAL_SECONDS=0.5
BACKOFF_BASE_SECONDS=2.0
